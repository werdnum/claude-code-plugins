{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-banned-commands.py"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-main-branch-commit.py"
          }
        ]
      },
      {
        "matcher": "BashOutput",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-bashoutput-rate-limit.py",
            "timeout": 360000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "${extensionPath}/scripts/check-banned-commands.py"
          },
          {
            "type": "command",
            "command": "${extensionPath}/scripts/check-main-branch-commit.py"
          }
        ]
      }
    ]
  }
}
