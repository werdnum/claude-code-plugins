{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/format-and-lint.py",
            "timeout": 15000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/check-linter-ignores.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "replace|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "${extensionPath}/scripts/format-and-lint.py",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "python3 ${extensionPath}/scripts/check-linter-ignores.py",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
